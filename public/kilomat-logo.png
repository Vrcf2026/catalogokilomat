		<style id="wp-custom-css">
			/* Barra preta fixa no topo (visível só em desktop/tablet) */
.elementor-element-b0e3796 {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #2e2e2e;
  color: #fff;
  z-index: 10000;
  padding: 5px 20px;
  display: flex;
  align-items: center;
}

/* Cabeçalho fixo abaixo da barra preta */
.elementor-element-84ffe0f {
  position: fixed;
  top: 40px; /* altura da barra preta */
  left: 0;
  width: 100%;
  z-index: 9999;
  background-color: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

/* Espaçamento no corpo para não esconder conteúdo */
body {
  margin-top: 120px; /* altura da barra + cabeçalho */
}

/* Ícones da barra preta em branco */
.elementor-element-b0e3796 svg {
  fill: #fff;
}

/* ===== MOBILE ADJUSTMENTS ===== */
@media (max-width: 767px) {
  /* Ocultar a barra preta no mobile */
  .elementor-element-b0e3796 {
    display: none !important;
  }

  /* Cabeçalho volta para o topo no mobile */
  .elementor-element-84ffe0f {
    top: 0 !important;
  }

  /* Ajuste do conteúdo abaixo do cabeçalho (sem barra preta) */
  body {
    margin-top: 80px;
  }
}

		</style>
		</head>

